# ========== Go 后端 (server/ 目录) ==========
# 编译后的可执行文件
server/*.exe
server/*.exe~
server/*.dll
server/*.so
server/*.dylib
# 测试和覆盖率文件
server/*.test
server/*.out
# 日志文件
server/log
# 依赖缓存（如果你用 vendor 模式）
server/vendor/
# Go workspace 文件
server/go.work
server/go.work.sum

# ========== Vue 前端 (web/ 目录) ==========
# 依赖包（体积巨大，必须忽略）
web/node_modules/
# 打包后的生产代码
web/admin/
web/dist-ssr/
# Vite 构建缓存
web/.vite/
# 类型检查缓存
web/*.tsbuildinfo
# 代码检查缓存
web/.eslintcache
# ========== Vue 前端 (web-front/ 目录) ==========
# 依赖包（体积巨大，必须忽略）
web-front/node_modules/
# 打包后的生产代码
web-front/www/
web-front/dist-ssr/
# Vite 构建缓存
web-front/.vite/
# 类型检查缓存
web-front/*.tsbuildinfo
# 代码检查缓存
web-front/.eslintcache

# ========== 环境变量与本地配置（含密钥！） ==========
# 针对 server 和 web 各自的本地环境变量
server/.env.local
server/.env.*.local
web/.env.local
web/.env.*.local
# 通用的本地临时文件
*.local

# ========== IDE 和操作系统垃圾文件 ==========
# IDEA / WebStorm / GoLand
.idea/
# VS Code
.vscode/
# Mac 系统
.DS_Store
# Windows 系统
Thumbs.db